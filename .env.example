# ELOG AI settings. Copy to .env and adapt. Docker Compose, systemd and
# `python -m elogai --env-file .env` all read this file.

# ---- Docker Compose --------------------------------------------------------------------------
# The two host folders of ELOG (the same values as in ELOG's own compose .env). They are mounted
# read-only at /usr/local/elog and /mnt/elog_data, the paths elogd.cfg refers to.
ELOG_DIR_HOST=/usr/local/elog
ELOG_DATA_HOST=/mnt/elog_data
# uid/gid that run elogd (id -u elog; id -g elog): the container runs as this user
ELOG_UID=1000
ELOG_GID=1000

# ---- Without Docker (systemd, python -m elogai) ----------------------------------------------
# Where elogd.cfg is. Logbook directory, logbooks, password file and admins are read from it.
# (Docker sets ELOG_DIR=/usr/local/elog and ELOGAI_STATE_DIR=/state itself.)
ELOG_DIR=/usr/local/elog
# ELOGD_CFG=/usr/local/elog/elogd.cfg     # only if the file is not $ELOG_DIR/elogd.cfg
# Database and caches (needs ~3 KB per entry plus embeddings)
ELOGAI_STATE_DIR=/var/lib/elog-ai

# ---- Both ------------------------------------------------------------------------------------
# Port on 127.0.0.1; nginx proxies /ai/ to it
ELOGAI_PORT=8091
# How this service reaches elogd to check access (default: 127.0.0.1 and "Port" of elogd.cfg)
# ELOG_INTERNAL_URL=http://127.0.0.1:8000

# Extra admins of the AI status page, besides "Admin user" of [global]
# ELOGAI_ADMINS=someone
# Token for scripts: Authorization: Bearer <token> (acts as an admin)
# ELOGAI_API_TOKEN=

# ---- AI provider -----------------------------------------------------------------------------
# ollama | openai (any OpenAI-compatible server) | anthropic | gemini | none
AI_PROVIDER=ollama
# The remote Ollama. Behind Open WebUI use its Ollama proxy, <open-webui URL>/ollama, with an
# Open WebUI API key (Settings > Account > API keys); a plain Ollama needs no key.
AI_BASE_URL=https://openwebui.example.org/ollama
# AI_API_KEY=sk-...

# Answers, digests, thread summaries: largest current model with a long context
AI_CHAT_MODEL=gemma4:31b
# Background analysis of every entry (JSON, many calls): small and fast
AI_FAST_MODEL=gemma4:latest
# Semantic search: multilingual (English and Slovenian), 2560 dimensions
AI_EMBED_MODEL=qwen3-embedding:4b
# Optional: describe image attachments (screenshots, plots) so they become searchable
# AI_VISION_MODEL=qwen2.5vl:7b

# Context window per request (tokens) and how much entry text goes into one question
AI_NUM_CTX=16384
AI_CONTEXT_CHARS=30000

# Background analysis: all | new (only entries written from now on) | off
AI_ENRICH=all
# Only analyse entries after this date automatically (older ones when somebody opens them)
# AI_ENRICH_SINCE=2025-01-01
# Short entries per request (1 for small local models if they mix entries up)
AI_ENRICH_BATCH=4

# Logbooks whose text must never go to an external provider (only to Ollama or a local URL)
# AI_PRIVATE_LOGBOOKS=Secret logbook, Another one

# Language of answers and digests
AI_LANGUAGE=English

# A sentence about the lab: makes summaries and answers use the right vocabulary
AI_SITE_CONTEXT=F7 department, Jozef Stefan Institute: ultrafast lasers (Legend, Pharos, Carbide, RegA), time-resolved HHG spectroscopy (4dmag), STM nanoprobe, transient grating, magneto-transport; samples such as 1T-TaS2.

# AI_TIMEOUT=300
